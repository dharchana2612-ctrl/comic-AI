# GEMINI_API_KEY: Required for Gemini AI API calls (Gemini Flash outline and Gemini Pro storytelling).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# HF_API_KEY: Optional Hugging Face Diffusers API token for Stable Diffusion image generation.
HF_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

